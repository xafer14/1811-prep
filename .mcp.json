{
  "mcpServers": {
    "chrome-devtools": {
      "command": "node",
      "args": [
        "node_modules/chrome-devtools-mcp/out/Default/gen/src/bin/chrome-devtools-mcp.js",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--no-file-navigations"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    }
  }
}
