---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** A wider page, for tables. */
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const path = Astro.url.pathname;
const current = (href: string): 'page' | undefined => (path === href ? 'page' : undefined);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class={wide ? 'wide' : undefined}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">
            1811
          </span>
          1811 Prep
        </a>
        <nav aria-label="Main">
          <a href="/organizations/" aria-current={current('/organizations/')}>
            Organizations
          </a>
          <a href="/compare/" aria-current={current('/compare/')}>
            Compare
          </a>
          <a href="/readiness/" aria-current={current('/readiness/')}>
            Readiness tool
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Not affiliated with, endorsed by, or sponsored by any government agency or military service.
      </p>
      <p>
        Educational information only, not medical, legal or financial advice. Standards change;
        always check the official source linked next to each number.
      </p>
    </footer>
  </body>
</html>
